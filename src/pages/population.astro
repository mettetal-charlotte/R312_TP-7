---
import Layout from "../layouts/Layout.astro";
import populationMain from "../assets/populationMain.json";

const listePeriode = [
    ...new Set(populationMain?.map((d) => d.Période)),
].reverse();
const listeSexe = [...new Set(populationMain?.map((d) => d.Sexe))];
const listeAge = [...new Set(populationMain?.map((d) => d["Âge"]))];
---

<Layout>
    <header class="bg-amber-100">
        <a href="/" class="p-2">Accueil</a>
        <a class="population-link" href="/population"> Voir la population </a>
    </header>
    <div class="flex gap-4 mb-4 p-2">
        <select id="periode" class="p-2 border rounded">
            {
                listePeriode.map((p, i) => (
                    <option selected={i === 0} value={p}>
                        {p}
                    </option>
                ))
            }
        </select>
        <select id="sexe" class="p-2 border rounded">
            {
                listeSexe.map((s, i) => (
                    <option selected={i === 0} value={s}>
                        {s}
                    </option>
                ))
            }
        </select>
        <select id="age" class="p-2 border rounded">
            {
                listeAge.map((a, i) => (
                    <option selected={i === 0} value={a}>
                        {a}
                    </option>
                ))
            }
        </select>
    </div>

    <div id="carte-container"></div>

    <script>
        import * as Plot from "@observablehq/plot";
        import departements from "../assets/departements.geojson.json";
        import populationMain from "../assets/populationMain.json";

        const elmYear = document.getElementById("periode") as HTMLSelectElement;
        const elmSex = document.getElementById("sexe") as HTMLSelectElement;
        const elmAge = document.getElementById("age") as HTMLSelectElement;
        const container = document.getElementById("carte-container");

        function renderMap() {
            let selectedYear = Number(elmYear.value);
            let selectedSex = elmSex.value;
            let selectedAge = elmAge.value;
            const optionPlot = {
                title: `Population française en ${selectedYear}`,
                subtitle: `Donnes filtrées pour le sexe : ${selectedSex} et la tranche d'âge : ${selectedAge}`,
                ariaLabel: "Carte intéractive de la population par département",
                ariaDescription: `Cette carte chorophète affiche la population de chaque département français pour l'année ${selectedYear}.
                Plus la couleur vert est foncée, plus la population est élevée.`,
                projection: {
                    type: "mercator",
                    domain: departements,
                },
                color: {
                    type: "quantile",
                    n: 8,
                    scheme: "Greens",
                    label: "Population en centaine de milliers",
                    legend: true,
                    transform: (d) => Math.round(d / 100000),
                },
                marks: [
                    Plot.geo(departements, {
                        fill: (d) => {
                            const deptName = d.properties.nom;
                            const popData = populationMain.find(
                                (p) =>
                                    p.Géographie === deptName &&
                                    p.Période === selectedYear &&
                                    p.Sexe === selectedSex &&
                                    p["Âge"] === selectedAge,
                            );
                            return popData?.Valeur ?? 0;
                        },
                        stroke: "#999",
                        title: (d) => {
                            const deptName = d.properties.nom;
                            const popData = populationMain.find(
                                (p) =>
                                    p.Géographie === deptName &&
                                    p.Période === selectedYear &&
                                    p.Sexe === selectedSex &&
                                    p["Âge"] === selectedAge,
                            );
                            return `${deptName} : ${popData?.Valeur || "Donnée indisponible"}`;
                        },
                        tip: true,
                    }),
                ],
            };
            if (container) {
                container.innerHTML = "";
                container.append(Plot.plot(optionPlot));
            }
        }

        elmYear.addEventListener("change", renderMap);
        elmSex.addEventListener("change", renderMap);
        elmAge.addEventListener("change", renderMap);
        renderMap();
    </script>
</Layout>
