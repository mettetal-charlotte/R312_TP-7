---
// Import des styles CSS de Leaflet pour l'affichage de la carte
import "leaflet/dist/leaflet.css";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <header class="bg-amber-100">
      <a href="/" class="p-2">Accueil</a>
      <a class="population-link" href="/population"> Voir la population </a>
    </header>
    <div>
      <h1 id="titre-carte" class="m-2 text-2xl">Carte des établissements</h1>
      <p id="desc-carte" class="m-2">Explorez la localisation des établissements en France.</p>
    </div>
    <div id="map" style="height: 600px;" role="region" aria-labelledby="Carte des établissements" aria-describedby="La carte localise les différents établissemnts français avec des ronds rouges"></div>
  </main>

  <script>
    import listeEtablissements from "../assets/listeEtablissements.json";
    import L from "leaflet";

    const map = L.map("map").setView([46.6033, 1.883], 6);
    // ... https://leafletjs.com/examples/quick-start/
    // ...

    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: "&copy; OpenStreetMap contributors",
    }).addTo(map);

    listeEtablissements.forEach((et) => {
      const dot = L.circleMarker([et.lat, et.lon], {
        color: "red",
        radius: 2,
        fillColor: "red",
        opacity: 0.25,
      }).addTo(map);
      dot.bindPopup(et.name);
    });
  </script>
</Layout>
